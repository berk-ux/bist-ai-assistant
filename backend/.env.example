# .env.example
# Render.com üzerinde "Environment Variables" kısmına eklenecekler:

# JWT Şifreleme Anahtarı (Güvenli, rastgele bir metin girin)
JWT_SECRET=super-secret-production-key-12345

# Supabase veya Neon.tech'ten alacağınız PostgreSQL Bağlantı Adresi
DATABASE_URL=postgres://kullanici:sifre@host:5432/veritabani_adi
